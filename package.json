{
  "name": "griha-ai",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint apps packages",
    "render": "npm run build -w @griha/render-cli && node apps/render-cli/dist/bin.js",
    "obs": "npm run build -w @griha/obs-cli && node apps/obs-cli/dist/bin.js"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/eslint-parser": "^8.0.5",
    "@babel/preset-typescript": "^8.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "turbo": "^2.5.0",
    "typescript": "^7.0.2"
  }
}
